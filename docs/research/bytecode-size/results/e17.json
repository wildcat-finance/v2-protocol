    {
      "regression": "test_boundedPaymentRoundingCanFinishFundingAndClearPrincipal",
      "issue": "Post-repayment old-batch rounding can complete backing and close, clearing drawn principal."
    },
    {
      "regression": "test_forcedQueueThatClosesMarketRetainsItsBatchClaim",
      "issue": "Forced queue can close in the same call, clearing the pending key; preserve the emitted key."
    },
    {
      "regression": "test_donationAndPendingPaymentCanDrainAfterScheduledClosure",
      "issue": "Preview and actual pending payments can differ by one unit of allocation rounding. Permit only that bounded top-up in the drain; require automatic closure."
    }
