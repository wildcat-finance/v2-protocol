{
  "version": "2.5.6",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.21.0",
    "yarn": "1.22.22"
  },
  "devDependencies": {
    "@solidity-parser/parser": "^0.16.0",
    "prettier": "^2.8.8",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "6.2.4"
  },
  "scripts": {
    "inventory:contracts": "node scripts/generate-contract-inventory.js",
    "lint:check": "forge fmt --check src test && solhint --disc --noPoster --config ./.solhint.json --ignore-path ./.solhintignore 'src/**/*.sol' 'test/**/*.sol'",
    "lint:fix": "forge fmt src test && solhint --disc --noPoster --config ./.solhint.json --ignore-path ./.solhintignore 'src/**/*.sol' 'test/**/*.sol'",
    "clean:coverage": "rm -rf coverage lcov.info",
    "coverage": "./scripts/coverage.sh",
    "test": "forge test",
    "test:fixed": "forge test --block-timestamp 1724284800 --fuzz-seed 0x5eed",
    "test:ir": "FOUNDRY_PROFILE=ir forge test --block-timestamp $(date +%s)",
    "compile": "forge compile",
    "compile:ir": "FOUNDRY_PROFILE=ir forge compile",
    "compile:unoptimizedir": "FOUNDRY_PROFILE=unoptimizedir forge compile"
  },
  "dependencies": {
    "ethers": "6.17.0"
  }
}
