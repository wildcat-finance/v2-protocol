{
  "version": "2.5.0",
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "^1.0.1",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@typechain/ethers-v5": "^10.2.1",
    "@typechain/hardhat": "^6.1.6",
    "hardhat": "^2.13.0",
    "open-cli": "^7.2.0",
    "prettier": "^2.8.8",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "^3.6.2",
    "solhint-plugin-prettier": "^0.0.5",
    "stack-packer": "^1.1.8",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "codegen": "stack-packer ./type-defs ./src/types -t ./contracts/test -h ./contracts/test",
    "lint:check": "prettier --check 'src/**/*.sol' 'test/**/*.sol' 'test-next/**/*.sol' && solhint --config ./.solhint.json --ignore-path ./.solhintignore 'src/**/*.sol' 'test/**/*.sol' 'test-next/**/*.sol'",
    "lint:fix": "prettier --write 'src/**/*.sol' 'test/**/*.sol' 'test-next/**/*.sol' && solhint --config ./.solhint.json --ignore-path ./.solhintignore 'src/**/*.sol' 'test/**/*.sol' 'test-next/**/*.sol'",
    "clean:coverage": "rm -rf coverage lcov.info",
    "coverage": "./scripts/test-next-coverage.sh",
    "test": "forge test",
    "test:fixed": "forge test --block-timestamp 1724284800 --fuzz-seed 0x5eed",
    "test:legacy": "FOUNDRY_PROFILE=legacy forge test --no-match-path 'test/fizz/**' --block-timestamp $(date +%s)",
    "test:legacy:fixed": "FOUNDRY_PROFILE=legacy forge test --no-match-path 'test/fizz/**' --block-timestamp 1724284800 --fuzz-seed 0x5eed",
    "test:parity": "node scripts/test-suite-parity.js --check",
    "test:parity:update": "node scripts/test-suite-parity.js --write",
    "test:next": "yarn test",
    "test:next:fixed": "yarn test:fixed",
    "coverage:next": "yarn coverage",
    "test:ir": "FOUNDRY_PROFILE=ir forge test --block-timestamp $(date +%s)",
    "compile": "forge compile",
    "compile:ir": "FOUNDRY_PROFILE=ir forge compile",
    "compile:unoptimizedir": "FOUNDRY_PROFILE=unoptimizedir forge compile"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.3",
    "@types/node": "^20.4.2",
    "cli-barchart": "^0.2.3",
    "ethers": "^6.6.3"
  }
}
