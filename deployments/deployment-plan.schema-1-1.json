{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildcat.finance/schemas/deployment-plan.schema-1-1.json",
  "title": "Wildcat Deployment Plan 1.1",
  "description": "An ordered, resumable deployment ceremony executed by one expected executor.",
  "type": "object",
  "required": [
    "schemaVersion",
    "foundryProfile",
    "network",
    "chainId",
    "release",
    "expectedExecutor",
    "onFailure",
    "resume",
    "transactions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "foundryProfile": {
      "const": "deploy",
      "description": "Foundry profile used to produce and validate all referenced artifacts."
    },
    "network": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "chainId": {
      "type": "integer",
      "minimum": 1
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "expectedExecutor": {
      "$ref": "#/$defs/address"
    },
    "onFailure": {
      "const": "halt"
    },
    "resume": {
      "const": "re-verify all prior predicates before continuing"
    },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transaction"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "hexData": {
      "type": "string",
      "pattern": "^0x(?:[a-fA-F0-9]{2})*$"
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^.]+$"
    },
    "reference": {
      "type": "object",
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "$ref": "#/$defs/safeId"
        }
      },
      "additionalProperties": false
    },
    "addressOrRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/address"
        },
        {
          "$ref": "#/$defs/reference"
        }
      ]
    },
    "argument": {
      "anyOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": ["string", "integer", "boolean", "null"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/argument"
          }
        }
      ]
    },
    "gasLimitPolicy": {
      "oneOf": [
        {
          "const": "estimate*1.3"
        },
        {
          "type": "object",
          "required": ["type", "gasLimit"],
          "properties": {
            "type": {
              "const": "explicit"
            },
            "gasLimit": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*|0x[1-9a-fA-F][0-9a-fA-F]*)$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "envelope": {
      "type": "object",
      "required": [
        "chainId",
        "expectedExecutor",
        "to",
        "value",
        "data",
        "gasLimitPolicy",
        "nonceCheck"
      ],
      "properties": {
        "chainId": {
          "type": "integer",
          "minimum": 1
        },
        "expectedExecutor": {
          "$ref": "#/$defs/address"
        },
        "to": {
          "oneOf": [
            {
              "$ref": "#/$defs/addressOrRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*|0x[0-9a-fA-F]+)$",
          "default": "0"
        },
        "data": {
          "enum": ["initCode+constructorArgs", "functionSignature+args"]
        },
        "gasLimitPolicy": {
          "$ref": "#/$defs/gasLimitPolicy",
          "default": "estimate*1.3"
        },
        "nonceCheck": {
          "const": "display-and-confirm"
        }
      },
      "additionalProperties": false
    },
    "constructorArgs": {
      "type": "object",
      "required": ["types", "decoded", "encoded"],
      "properties": {
        "types": {
          "type": "array",
          "description": "Canonical ABI constructor input types copied from the deploy-profile artifact.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decoded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "encoded": {
          "$ref": "#/$defs/hexData",
          "description": "Review encoding; unresolved address references are encoded as the zero address and rebuilt at execution."
        }
      },
      "additionalProperties": false
    },
    "predicateCall": {
      "type": "object",
      "required": ["sig", "args"],
      "properties": {
        "sig": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        }
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": {
          "enum": ["codePresent", "callEq"]
        },
        "target": {
          "$ref": "#/$defs/addressOrRef"
        },
        "call": {
          "$ref": "#/$defs/predicateCall"
        },
        "expect": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "callEq"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["call", "expect"]
          }
        }
      ]
    },
    "transaction": {
      "type": "object",
      "required": ["id", "kind", "description", "envelope", "predicate"],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "kind": {
          "enum": ["deploy", "call"]
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^\\r\\n]+[.!?]$"
        },
        "reverifyUntil": {
          "$ref": "#/$defs/safeId",
          "description": "Optional later compensating transaction. This predicate remains mandatory on resume until that transaction is verified, then becomes historical."
        },
        "artifactName": {
          "type": "string",
          "minLength": 1
        },
        "initCode": {
          "$ref": "#/$defs/hexData"
        },
        "constructorArgs": {
          "$ref": "#/$defs/constructorArgs"
        },
        "output": {
          "$ref": "#/$defs/safeId"
        },
        "to": {
          "$ref": "#/$defs/addressOrRef"
        },
        "functionSignature": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "calldata": {
          "$ref": "#/$defs/hexData",
          "description": "Review encoding; execution rebuilds calldata from the signature and resolved arguments."
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        },
        "predicate": {
          "$ref": "#/$defs/predicate"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "deploy"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": [
              "artifactName",
              "initCode",
              "constructorArgs",
              "output"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "call"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["to", "functionSignature", "args", "calldata"]
          }
        }
      ]
    }
  }
}
