{
  "name": "wildcat-deploy-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "test": "vitest run --exclude 'src/engine/__tests__/*.fork.test.ts'",
